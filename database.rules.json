{
    "rules": {
        ".read": false,
        ".write": false,
        "users": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            "$uid": {
                ".read": "auth != null && auth.uid === $uid",
                ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
            }
        },
        "students": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'sheikh')"
        },
        "pre_registrations": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
        },
        "activity_logs": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            ".write": "auth != null"
        },
        "shared_records": {
            "$recordId": {
                ".read": true,
                ".write": "auth != null"
            }
        },
        "meetings": {
            ".read": "auth != null",
            "$meetingId": {
                ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
                "suggestions": {
                    "$suggestionId": {
                        ".write": "auth != null"
                    }
                }
            }
        },
        "public_student_reports": {
            "$studentId": {
                ".read": true,
                ".write": "auth != null"
            }
        },
        "site_updates": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
        },
        "absence_reasons": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
        },
        "summer_camp_items": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
        },
        "admin_documents": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
            ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
        },
        "settings": {
            "sheikh_scoring_weights": {
                ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
                ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
            },
            "sheikh_goals": {
                "$monthKey": {
                    ".read": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')",
                    ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('profile').child('role').val() === 'management')"
                }
            }
        }
    }
}